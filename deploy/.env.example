# Copy to deploy/.env and edit. Read by deploy/compose.yml.

# The domain people will open. Its DNS must point at this server.
GHIS_DOMAIN=stories.example.com

# The login Caddy asks for. Make the hash with: docker run --rm caddy:2 caddy hash-password
# Keep the single quotes: the hash is full of $ signs. Caddy refuses to start without one.
GHIS_LOGIN=team
GHIS_PASSWORD_HASH=''

# Hosts this server may call. Add your self-hosted GitLab, GitHub Enterprise or Forgejo.
GHIS_ALLOWED_HOSTS=github.com,gitlab.com,codeberg.org,bitbucket.org,git.sr.ht

# Start everyone's form on your own instance (optional; the URL's host must be allowed above).
# GHIS_DEFAULT_PROVIDER=gitlab
# GHIS_DEFAULT_URL=https://gitlab.example.com

# Limits.
GHIS_MAX_JOBS=2
GHIS_TTL_MINUTES=60
GHIS_MAX_STORIES=200
GHIS_GIT_TIMEOUT=600

# Pin a release instead of :latest, or use :edge for the newest build of main.
# GHIS_IMAGE=ghcr.io/radufarcas10/ghis:0.1.0
